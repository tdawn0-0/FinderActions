{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld actions ready in Finder" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld actions ready in Finder"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个动作在访达中就绪"
          }
        }
      }
    },
    "1. Allow access to protected folders" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Allow access to protected folders"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 允许访问受保护文件夹"
          }
        }
      }
    },
    "1. Open Full Disk Access in macOS System Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Open Full Disk Access in macOS System Settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 在 macOS 系统设置中打开“完全磁盘访问权限”。"
          }
        }
      }
    },
    "2. Click + and select FinderActions.app, or drag the app into the list." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Click + and select FinderActions.app, or drag the app into the list."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 点击 + 并选择 FinderActions.app，或直接将应用拖入列表中。"
          }
        }
      }
    },
    "2. Enable the Finder extension" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Enable the Finder extension"
