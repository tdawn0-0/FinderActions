    "Finder always renders one single “Open in Terminal” menu item. Selected terminal will launch with the working directory." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder always renders one single “Open in Terminal” menu item. Selected terminal will launch with the working directory."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "访达右键菜单中始终呈现唯一的“在终端中打开”项目，点击将使用所选终端打开工作目录。"
          }
        }
      }
    },
    "FinderActions is completely offline. No telemetry, no accounts, and no data leaves your device." : {
      "extractionState" : "manual",
